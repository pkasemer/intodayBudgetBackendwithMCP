# Copy to .env on the server and fill in. Never commit .env.
# Generate both with:  openssl rand -hex 32
# (hex only: DB_PASSWORD is embedded in DATABASE_URL, so avoid URL-special characters)
API_TOKEN=
DB_PASSWORD=

# Optional
# API_PORT=8100            # loopback port the existing reverse proxy forwards to
# APP_TIMEZONE=Africa/Kampala
